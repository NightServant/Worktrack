# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
*.local

# Environment files with secrets
.env
.env.local
.env.*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python
__pycache__/
*.py[cod]
*$py.class
.Python
*.so
.env
venv/
ENV/

# Analysis script output (scripts/data_analysis.py)
scripts/*.png
scripts/*.csv

# Supabase CLI local link state (machine-specific, must not be committed)
supabase/.temp/

# Next.js
.next/
next-env.d.ts
.vercel

# TypeScript incremental build cache
tsconfig.tsbuildinfo
*.tsbuildinfo

# Written by the session-bridge plugin per project; a per-session pointer,
# not configuration. `.claude/` is otherwise tracked here (launch.json).
.claude/bridge-session

# The extractor's own Python environment (M7). `venv/` at the repo root is a
# separate scratch environment holding matplotlib/pandas and is NOT this.
scraper/.venv/
scraper/**/__pycache__/
scraper/.pytest_cache/
*.pyc

# Sentry Config File
.env.sentry-build-plugin
