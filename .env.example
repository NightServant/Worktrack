# Supabase Configuration
# Get these values from the Supabase project settings > API
# Next.js reads these. The VITE_ pair below is the fallback for the Vite app,
# which is removed in M3 Task 7 along with those two lines.
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Sentry needs NO environment variable here. `@sentry/nextjs` initialises from
# src/instrumentation-client.ts, sentry.server.config.ts and
# sentry.edge.config.ts, each carrying the DSN literally -- a DSN is public by
# design and ships in the client bundle either way.
#
# SENTRY_AUTH_TOKEN is the exception, and it is a real secret: it uploads source
# maps at build time. The wizard wrote it to .env.sentry-build-plugin, which is
# gitignored. Production builds need the same token set in Vercel, or stack
# traces arrive minified.

# Integration tests (npm run test:integration) sign in as a real user so that
# RLS actually applies. Create a dedicated account in the Supabase dashboard --
# do not reuse a personal login, since these tests write and delete rows.
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# Demo account seeding (npm run seed:demo). Must NOT be in demo_accounts when
# the seed runs -- RLS would refuse every insert. Add it to demo_accounts after.
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=

# The deployed origin, e.g. https://worktrack.example.com
# Read ONLY by `supabase config push` (supabase/config.toml), never by the app.
# It has no default on purpose: a missing value fails the push loudly instead
# of pointing production auth emails at localhost.
SUPABASE_AUTH_SITE_URL=

# --- Custom SMTP, for the signup verification code ---
# Read ONLY by `supabase config push`, never by the app.
#
# Without these the project falls back to Supabase's built-in email provider,
# which (a) is rate limited to a couple of messages an hour and (b) makes the
# free tier REFUSE email-template changes -- which is what stops the signup
# code from ever being sent.
#
# BREVO, NOT RESEND, SINCE 2026-09-15. The switch is the whole reason signup
# codes can now reach a stranger: Resend's shared sender delivers only to the
# Resend account owner and lifting that needs a verified DOMAIN, while Brevo
# verifies a single SENDER ADDRESS -- an ordinary Gmail is fine -- and then
# sends to anybody. 300 a day on the free tier. See supabase/config.toml.

# The Brevo login email. It is the SMTP username, which is not obvious: it is
# not the sender address and not an API identifier.
SUPABASE_AUTH_SMTP_USER=

# BREVO_SMTP_KEY: LEAVE THIS EMPTY if you have stored it in the macOS keychain.
# scripts/push-auth-config.sh reads it from service "worktrack-smtp" when this
# is unset, which keeps an SMTP password out of a plaintext file in the working
# tree. Store it once with:
#   security add-generic-password -s worktrack-smtp -a brevo -w
# Set it here only on a machine with no keychain, e.g. CI.
#
# It is an SMTP KEY from Brevo's SMTP & API page -- NOT the account password,
# and NOT the transactional API key, which is a different credential that will
# authenticate against the API and fail against the relay.
BREVO_SMTP_KEY=

# The From address, which must be a sender you have VERIFIED in Brevo. Brevo
# emails that address a confirmation link; until it is clicked every send is
# rejected. A Gmail address is a valid sender -- no domain required, which is
# the point of the switch.
SUPABASE_AUTH_SMTP_SENDER=

# --- Integrations (all optional; see docs/INTEGRATIONS.md) -------------------
# LaTeX -> PDF. Verified endpoint: POST https://api.formatex.io/api/v1/compile
FORMATEX_API_KEY=
FORMATEX_BASE_URL=https://api.formatex.io/api/v1

# CV tailoring over ANY OpenAI-compatible chat endpoint. Named for the contract
# rather than a vendor, because free tiers move. NOT NEXT_PUBLIC_: the key is
# read server-side by /api/tailor and must never reach the browser.
TAILORING_BASE_URL=
TAILORING_API_KEY=
TAILORING_MODEL=

# EU skills taxonomy for ATS synonyms. Free and keyless; set to false to skip.
ESCO_ENABLED=true

# Firecrawl: a hosted fetch for the postings this server cannot read itself --
# JavaScript-rendered pages, and boards that refuse datacenter traffic.
#
# WHERE IT GOES. The fetch happens in the PYTHON service (scraper/app.py), not
# in Next -- so this key does nothing in .env.local, which only Next reads.
#   local       scraper/.env  (gitignored; app.py loads it at startup)
#   deployment  an ordinary Vercel project environment variable. They are
#               project-scoped, not per-service, so one entry reaches the
#               Python service: `vercel env add FIRECRAWL_API_KEY production`
#
# Optional. Without it the extractor still reads every ordinary page over
# plain HTTP, and falls back to a local browser if one is installed
# (`npm run setup:scraper` installs it; a deployment cannot).
#
# Free tier is 1,000 scrapes a month, which is far more than one person's job
# search needs. Every posting URL you auto-fill is sent to them -- /privacy
# says so.
FIRECRAWL_API_KEY=

# --- Apify: reading your own LinkedIn profile ------------------------------
#
# WHAT IT IS FOR. Settings -> Profile builds your profile from its public
# LinkedIn address. Firecrawl cannot do this one: it is a fetcher, and what
# LinkedIn serves a signed-out visitor is an anti-bot challenge rather than a
# page. This actor solves that server-side and returns structured JSON --
# including the bullet text under each role, which is the part a CV is written
# from and the part no other source has ever given us.
#
# WHERE IT GOES. Same place as FIRECRAWL_API_KEY, and for the same reason: the
# fetch is in the PYTHON service, so this does nothing in .env.local.
#   local       scraper/.env
#   deployment  `vercel env add APIFY_TOKEN production`
#
# WHAT IT COSTS, which is worth reading before you enable it. The actor is
# pay-per-event: $0.50 per GIGABYTE of memory at start (minimum one event),
# plus $0.01 per profile returned. The service pins the run to 1024MB, so one
# profile import is about $0.51. Apify's free tier is $5 of monthly credit --
# roughly nine imports. Nobody imports their own profile nine times a month,
# but a stuck retry loop would, which is why /api/profile allows three
# attempts a minute.
#
# Optional. Without it the profile import falls back to Firecrawl, which works
# only on the minority of profiles served without a challenge.
APIFY_TOKEN=

# The actor to run, if you ever swap it. Default is the one above.
# APIFY_PROFILE_ACTOR=crawlerbros~linkedin-profile-scraper
