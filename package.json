{
  "name": "job-search-tracker",
  "private": true,
  "license": "MIT",
  "version": "1.0.0",
  "homepage": "https://github.com/NightServant/Worktrack",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "load:autofill": "npx artillery run load-tests/job-autofill.yml",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "seed:demo": "node --env-file=.env scripts/seed-demo.mjs",
    "start": "next start",
    "push:auth-config": "bash scripts/push-auth-config.sh",
    "verify:domain": "bash scripts/verify-sending-domain.sh",
    "test:scraper": "cd scraper && .venv/bin/python -m pytest -q",
    "setup:scraper": "python3.13 -m venv scraper/.venv && scraper/.venv/bin/pip install -e 'scraper[dev,browser]'",
    "dev:scraper": "cd scraper && .venv/bin/python -m uvicorn app:app --host 127.0.0.1 --port 8000 --reload"
  },
  "dependencies": {
