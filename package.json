    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.45.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.51.0",
    "@tiptap/core": "^3.22.5",
    "@tiptap/extension-highlight": "^3.22.5",
